# ══════════════════════════════════════════════════════════════════
# FLOWUP CUSTOMER FRONTEND — Environment Configuration
# ══════════════════════════════════════════════════════════════════

# Customer app is served at the production domain: https://app.flowup.co.in
# Public restaurant URLs are root-level slugs: https://app.flowup.co.in/<slug>
# The SPA _redirects file (public/_redirects) rewrites all paths to index.html
# so direct navigation / refresh on /<slug> works.

# Backend API URL (include /api suffix)
# Dev: leave unset (Vite proxy forwards /api → localhost:5000)
# Prod: https://your-backend.onrender.com/api
VITE_API_URL=

# Socket.IO server URL (backend root, no /api)
# Dev: http://localhost:5000
# Prod: https://your-backend.onrender.com
VITE_SOCKET_URL=

# Restaurant identifier — used as fallback during multi-tenant transition.
# In shared deployment: leave empty. restaurantId comes from QR URL (?restaurant=flw_xxx).
# In single-tenant legacy deployment: set to your restaurant ID.
VITE_RESTAURANT_ID=

# Razorpay public key (only needed if online payment is enabled)
# Get from: https://dashboard.razorpay.com/app/keys (use TEST key for dev)
VITE_RAZORPAY_KEY_ID=
